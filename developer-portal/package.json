{
  "name": "@perkos/nayori-docs",
  "version": "0.1.0",
  "description": "Professional developer portal for Nayori by PerkOS",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "npm run check:content && next build --webpack",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:content": "node scripts/check-content.mjs",
    "check:diagrams": "node scripts/check-mermaid.mjs",
    "check:openapi": "node scripts/check-openapi.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "verify": "npm run check:openapi && npm run check:diagrams && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-openapi": "11.3.5",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.4",
    "lucide-react": "^1.34.0",
    "mermaid": "11.17.2",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "4.4.3",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
