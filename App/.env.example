NEXT_PUBLIC_STACKS_NETWORK=mainnet
NEXT_PUBLIC_CONTRACT_ADDRESS=SP2K7PV5NXBNRV510S6DCA6RFMTFHAF3ZPK6ZSXPH
NEXT_PUBLIC_CONTRACT_PROFILE=current-v6-v5
# Active earned-service-fee contracts, source-verified on Stacks mainnet.
NEXT_PUBLIC_STX_COMMERCE_CONTRACT=agentic-commerce-v6
NEXT_PUBLIC_SBTC_COMMERCE_CONTRACT=sbtc-commerce-v5
NEXT_PUBLIC_REPUTATION_CONTRACT=reputation-registry-v3
NEXT_PUBLIC_NAYORI_EVALUATOR_ADDRESS=SP3GRG5CKEFNYM5BV0NPPHCM51FT176JQ02QWQ9T3
# Keep false until the managed evaluator runtime is independently activated in production.
NEXT_PUBLIC_NAYORI_MANAGED_EVALUATOR_ENABLED=false
NEXT_PUBLIC_NAYORI_APPEAL_AUTHORITY_ADDRESS=SP2R584GC8W2A921080TY8CQ8P1GZ6JNXYXS65DA6

# Public origin used for canonical and social metadata. Change only after the target domain and
# deployment are live; previews should use their own public origin.
NEXT_PUBLIC_SITE_URL=https://nayori.ai

# Optional: protects POST /api/chainhook when the receiver is registered.
CHAINHOOK_SECRET=

# Disclosure only; must match operator-issued signer permits. Does not change custody or contracts.
# Defaults 6/6; mainnet minimum 6, testnet minimum 0, maximum 144; settlement >= workflow.
NAYORI_WORKFLOW_BURN_BLOCKS=6
NAYORI_SETTLEMENT_BURN_BLOCKS=6
# Optional marketplace registry (full principal, e.g. SP....job-applications-v1). Empty hides "Take this job".
NEXT_PUBLIC_JOB_APPLICATIONS_CONTRACT=

# Participant registry (self-service attestations at /participants). Server-side only.
# Postgres for QA and production; PARTICIPANT_STORE=memory for local development (lost on restart).
# Without either, POST /api/participants answers 503 and hands the signed entry back.
DATABASE_URL=
PARTICIPANT_STORE=

# Server-side chain reads. HIRO_API_KEY (from platform.hiro.so, free tier) raises Hiro's per-minute quota;
# without it the public quota applies. The transparency snapshot is read once per TRANSPARENCY_CACHE_MS
# (default 60000) and, if a refresh fails, the last good read is served for up to TRANSPARENCY_STALE_MS (default 1800000).
HIRO_API_KEY=
TRANSPARENCY_CACHE_MS=
TRANSPARENCY_STALE_MS=
