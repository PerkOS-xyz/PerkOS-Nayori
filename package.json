{
  "name": "perkos-nayori-contracts",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "description": "Clarity contracts and tests for Nayori — PerkOS Stacks Agentic Commerce",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "vitest run -- --coverage --costs",
    "security:gate": "node scripts/security-gate.mjs",
    "deploy:mainnet": "node scripts/deploy-current-mainnet.mjs",
    "preflight:versioned:mainnet": "STACKS_NETWORK=mainnet VERSIONED_ESCROW_MAINNET_ACTION=preflight node scripts/deploy-versioned-escrow-mainnet.mjs",
    "deploy:versioned:mainnet": "node scripts/deploy-versioned-escrow-mainnet.mjs",
    "preflight:e2e:versioned:mainnet": "STACKS_NETWORK=mainnet VERSIONED_ESCROW_MAINNET_E2E_ACTION=preflight node scripts/e2e-versioned-escrow-mainnet.mjs",
    "e2e:versioned:mainnet": "node scripts/e2e-versioned-escrow-mainnet.mjs",
    "deploy:stx-v2": "node scripts/deploy-stx-v2.mjs",
    "deploy:versioned:testnet": "node scripts/deploy-versioned-escrow-testnet.mjs",
    "deploy:autonomous:testnet": "node scripts/deploy-autonomous-escrow-testnet.mjs",
    "preflight:autonomous:mainnet": "STACKS_NETWORK=mainnet AUTONOMOUS_ESCROW_MAINNET_ACTION=preflight node scripts/deploy-autonomous-escrow-mainnet.mjs",
    "deploy:autonomous:mainnet": "node scripts/deploy-autonomous-escrow-mainnet.mjs",
    "e2e:autonomous:mainnet": "node scripts/e2e-autonomous-escrow-mainnet.mjs",
    "e2e:versioned:testnet": "node scripts/e2e-versioned-escrow-testnet.mjs",
    "e2e:autonomous:testnet": "node scripts/e2e-autonomous-escrow-testnet.mjs",
    "e2e:stx-v2:testnet": "node scripts/e2e-stx-v2-testnet.mjs",
    "verify:mainnet": "node scripts/verify-current-mainnet.mjs",
    "e2e:qa:plan": "node scripts/e2e-qa-suite.mjs plan",
    "e2e:qa:preflight": "node scripts/e2e-qa-suite.mjs preflight",
    "e2e:qa:run": "node scripts/e2e-qa-suite.mjs run",
    "e2e:qa:resume": "node scripts/e2e-qa-suite.mjs resume",
    "preflight:identity:testnet": "STACKS_NETWORK=testnet QA_IDENTITY_DEPLOY_ACTION=preflight node scripts/deploy-qa-identity-testnet.mjs",
    "deploy:identity:testnet": "node scripts/deploy-qa-identity-testnet.mjs",
    "preflight:service-fee:testnet": "STACKS_NETWORK=testnet SERVICE_FEE_ACTION=preflight node scripts/deploy-service-fee-testnet.mjs",
    "deploy:service-fee:testnet": "node scripts/deploy-service-fee-testnet.mjs",
    "preflight:e2e:service-fee:testnet": "STACKS_NETWORK=testnet SERVICE_FEE_ACTION=preflight node scripts/e2e-service-fee-testnet.mjs",
    "e2e:service-fee:testnet": "node scripts/e2e-service-fee-testnet.mjs"
  },
  "devDependencies": {
    "@stacks/clarinet-sdk": "^3.8.1",
    "@stacks/transactions": "^7.4.0",
    "typescript": "^5",
    "vitest": "^3.2.0",
    "vitest-environment-clarinet": "^3.0.2"
  }
}
